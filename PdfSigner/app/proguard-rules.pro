# Add project specific ProGuard rules here.

# ?? PDFBox ????????????????????????????????????????????????????????????????????
-keep class com.tom_roush.pdfbox.** { *; }
-keep class org.bouncycastle.** { *; }
-dontwarn com.tom_roush.pdfbox.**
-dontwarn org.bouncycastle.**

# ?? kotlinx.serialization ?????????????????????????????????????????????????????
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt
-keepclassmembers @kotlinx.serialization.Serializable class ** {
    *** Companion;
}
-keepclasseswithmembers class ** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.pdfsigner.app.**$$serializer { *; }
-keepclassmembers class com.pdfsigner.app.** {
    *** Companion;
}
-keepclasseswithmembers class com.pdfsigner.app.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# ?? ML Kit Document Scanner ???????????????????????????????????????????????????
-keep class com.google.mlkit.** { *; }
-dontwarn com.google.mlkit.**
-keep class com.google.android.gms.internal.mlkit_vision_document_scanner.** { *; }

# ?? AndroidX Biometric ???????????????????????????????????????????????????????
-keep class androidx.biometric.** { *; }
-dontwarn androidx.biometric.**

# ?? Compose ???????????????????????????????????????????????????????????????????
-dontwarn androidx.compose.**

# ?? General ???????????????????????????????????????????????????????????????????
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# ?? FileProvider ??????????????????????????????????????????????????????????????
-keep class androidx.core.content.FileProvider { *; }
